# API Keys - Provide at least one of the following to power the LLM stages
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App configuration
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info

# Pipeline choices (optional overrides)
# LLM_PROVIDER: "gemini", "openai", or "anthropic" (defaults to auto-detecting based on provided keys)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
